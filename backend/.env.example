# Copy to .env for local runs. On Render, add these under Environment instead.

# Neon, pooled connection (host contains -pooler). The API uses this one.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
# Neon, direct connection. Only scripts/apply_sql.py uses this one.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Any long random string. The dashboard sends it as X-API-Key. Must equal API_KEY in Vercel.
API_KEY=change-me

# Optional
# BACKGROUND_JOBS=true
# BACKGROUND_INTERVAL_SECONDS=60
# NOTIFY_FAILURE_RATE=0.0
# ANALYST_USER_ID=a0000000-0000-0000-0000-000000000006
# ALLOWED_ORIGINS=
