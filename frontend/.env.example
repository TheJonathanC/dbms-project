# Copy to .env.local for local runs. On Vercel, add these under Settings > Environment Variables.

# Where the API runs (no trailing slash). Locally: http://localhost:8000   On Render: https://your-service.onrender.com
API_URL=http://localhost:8000
# Must equal API_KEY in the backend.
API_KEY=change-me
# The password for the login page.
DASHBOARD_PASSWORD=change-me
# Any long random string; signs the login cookie.
SESSION_SECRET=change-me-too
